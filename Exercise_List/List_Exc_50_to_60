#51. Count how many times a value occurs in a list.
lst=[1,233,45,67,1,2,5,6,1]
count=0
value=int(input("Enter value from list you want to count occurrnece "))
for i in lst:
    if value==i:
        count+=1
print(f"occurence of {value} is {count} Times")

